{
  "name": "@chlrc/dsh-context-rollover",
  "description": "Summarization-free context rollover, durable model-managed notes and targeted history recovery for DeepSeek Harness.",
  "version": "0.2.3",
  "type": "module",
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KiritoKing/dsh-plugins.git",
    "directory": "packages/dsh-context-rollover"
  },
  "homepage": "https://github.com/KiritoKing/dsh-plugins/tree/main/packages/dsh-context-rollover#readme",
  "bugs": { "url": "https://github.com/KiritoKing/dsh-plugins/issues" },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./package.json": "./package.json"
  },
  "files": ["lib/**/*.js", "lib/types/**/*.d.ts", "cordis.patch.yml", "presets/*.patch.yml"],
  "dsh": {
    "bundle": { "patch": ["./cordis.patch.yml", "./presets/standard-rollover.patch.yml"] }
  },
  "scripts": {
    "generate:paths": "node scripts/generate-dsh-paths.mjs",
    "build": "node scripts/generate-dsh-build-paths.mjs && tsc -p tsconfig.build.json",
    "preset:sync": "node scripts/make-web-preset.mjs",
    "test": "node scripts/generate-dsh-paths.mjs && vitest run",
    "typecheck": "node scripts/generate-dsh-paths.mjs && tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-preset": "0.2.0-rc.2",
    "@deepseek-ai/dsh-commands": "0.2.0-rc.2",
    "@deepseek-ai/dsh-compaction": "0.2.0-rc.2",
    "@deepseek-ai/dsh-compaction-tool-result-pruner": "0.2.0-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-token-meter": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-agent-preset": { "optional": true },
    "@deepseek-ai/dsh-compaction-tool-result-pruner": { "optional": true }
  },
  "engines": { "node": ">=24 <25" },
  "keywords": ["deepseek-harness", "dsh", "dsh-plugin", "dsh-bundle", "context-window", "compaction", "context-management"]
}
