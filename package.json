{
  "name": "@chlrc/dsh-plugins-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "11.7.0",
    "npm": ">=11.5.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KiritoKing/dsh-plugins.git"
  },
  "scripts": {
    "check": "node scripts/check-public.mjs",
    "check:public": "node scripts/check-public.mjs --scan",
    "lint": "eslint .",
    "typecheck": "node scripts/check-public.mjs --typecheck",
    "test": "node scripts/check-public.mjs --test",
    "test:release": "node --test scripts/release-request.test.mjs scripts/prepare-release.test.mjs",
    "build": "node scripts/check-public.mjs --build",
    "audit:public": "node scripts/check-public.mjs --audit",
    "pack:inspect": "node scripts/check-public.mjs --pack"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^10.12.0",
    "globals": "^16.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "4.1.8"
  }
